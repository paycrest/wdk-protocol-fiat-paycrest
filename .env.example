# Server-side only. Never ship these values to a browser or mobile client.
# Create a sender account at https://app.paycrest.io to obtain them.
PAYCREST_API_KEY=your-paycrest-sender-api-key
PAYCREST_API_SECRET=your-paycrest-sender-api-secret

# Public URL where your server exposes the Paycrest routes (used to build checkout URLs).
PUBLIC_BASE_URL=https://your-backend.example.com/paycrest
PORT=3000
